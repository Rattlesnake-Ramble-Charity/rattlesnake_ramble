<table class="table">
  <tr>
    <th><%= link_to 'Racer', request.params.merge(sort: 'racer') %></th>
   <th><%= link_to 'Email', request.params.merge(sort: 'email') %></th>
    <th><%= link_to 'Gender', request.params.merge(sort: 'gender') %></th>
    <th><%= link_to 'Age', request.params.merge(sort: 'age') %></th>
    <th><%= link_to 'Bib #', request.params.merge(sort: 'bib') %></th>
<!--    <th><%#= link_to 'Start Time', request.params.merge(sort: 'start_time') %></th>-->
    <th><%= link_to 'Paid?', request.params.merge(sort: 'paid') %></th>
<!--    <th><%#= link_to 'Time', request.params.merge(sort: 'time') %></th>-->
    <th><%= link_to 'Merchandise Size', request.params.merge(sort: 'merchandise_size') %></th>
  </tr>

  <h3>Total entries: <%= race_entries.size %></h3>
  <% race_entries.each do |race_entry| %>
    <tr>
      <td><%= link_to race_entry.racer.name, edit_race_entry_path(race_entry)  %></td>
      <td><%= race_entry.racer.email %></td>
      <td><%= race_entry.racer.gender.titleize %></td>
      <td><%= race_entry.racer.current_age %></td>
      <td><%= race_entry.bib_number %></td>
<!--      <td><%#= race_entry.scheduled_start_time_military %></td>-->
      <td><%= race_entry.paid %></td>
      <td><%= race_entry.merchandise_size %></td>
<!--      <td><%#= race_entry.elapsed_time_na_if_nil %></td>-->
    </tr>
  <% end %>
</table>
